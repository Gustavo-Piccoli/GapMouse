<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapMouse.App.ViewModels"
             x:Class="GapMouse.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="20" MaxWidth="560" HorizontalAlignment="Left">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding L.SettingsGroupMovement}" FontWeight="SemiBold" FontSize="16" />
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsIdle}" />
          <TextBox Text="{Binding IdleText}" />
          <TextBlock Text="{Binding IdleError}" Classes="error" IsVisible="{Binding IdleError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsCheck}" />
          <TextBox Text="{Binding CheckText}" />
          <TextBlock Text="{Binding CheckError}" Classes="error" IsVisible="{Binding CheckError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsMin}" />
          <TextBox Text="{Binding MinText}" />
          <TextBlock Text="{Binding MinError}" Classes="error" IsVisible="{Binding MinError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsMax}" />
          <TextBox Text="{Binding MaxText}" />
          <TextBlock Text="{Binding MaxError}" Classes="error" IsVisible="{Binding MaxError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsAmplitude}" />
          <TextBox Text="{Binding AmplitudeText}" />
          <TextBlock Text="{Binding AmplitudeError}" Classes="error" IsVisible="{Binding AmplitudeError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding L.SettingsGroupPower}" FontWeight="SemiBold" FontSize="16" />
        <CheckBox IsChecked="{Binding KeepDisplayOn}" Content="{Binding L.SettingsKeepDisplayOn}" />
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding L.SettingsGroupSystem}" FontWeight="SemiBold" FontSize="16" />
        <CheckBox IsChecked="{Binding StartWithWindows}" Content="{Binding L.SettingsStartWithWindows}" />
        <CheckBox IsChecked="{Binding StartMinimized}" Content="{Binding L.SettingsStartMinimized}" />
        <CheckBox IsChecked="{Binding NotificationsEnabled}" Content="{Binding L.SettingsNotifications}" />
        <CheckBox IsChecked="{Binding CheckForUpdates}" Content="{Binding L.SettingsCheckUpdates}" />
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsHotkey}" />
          <TextBox x:Name="HotkeyBox" Text="{Binding HotkeyText}" IsReadOnly="True" />
          <TextBlock Text="{Binding L.SettingsHotkeyHint}" Opacity="0.7" />
          <TextBlock Text="{Binding HotkeyError}" Classes="error" IsVisible="{Binding HotkeyError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding HotkeyWarning}" Classes="warning" IsVisible="{Binding HotkeyWarning, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding L.SettingsGroupAppearance}" FontWeight="SemiBold" FontSize="16" />
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsTheme}" />
          <ComboBox SelectedIndex="{Binding ThemeIndex}">
            <ComboBoxItem Content="{Binding L.SettingsThemeDark}" />
            <ComboBoxItem Content="{Binding L.SettingsThemeLight}" />
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsLanguage}" />
          <ComboBox SelectedIndex="{Binding LanguageIndex}">
            <ComboBoxItem Content="{Binding L.SettingsLanguageAuto}" />
            <ComboBoxItem Content="{Binding L.SettingsLanguagePortuguese}" />
            <ComboBoxItem Content="{Binding L.SettingsLanguageEnglish}" />
          </ComboBox>
        </StackPanel>
      </StackPanel>
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding L.SettingsGroupLogs}" FontWeight="SemiBold" FontSize="16" />
        <CheckBox IsChecked="{Binding SaveLogsToFile}" Content="{Binding L.SettingsSaveLogs}" />
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding L.SettingsRetention}" />
          <TextBox Text="{Binding RetentionText}" />
          <TextBlock Text="{Binding RetentionError}" Classes="error" IsVisible="{Binding RetentionError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="{Binding L.SettingsSave}" Command="{Binding SaveCommand}" />
        <Button Content="{Binding L.SettingsRestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding StatusMessage}" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
