<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapMouse.App.ViewModels"
             xmlns:v="using:GapMouse.App.Views"
             x:Class="GapMouse.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <UserControl.Resources>
    <v:LogKindBrushConverter x:Key="KindBrush" />
    <v:LogKindInkConverter x:Key="KindInk" />
  </UserControl.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <ComboBox SelectedIndex="{Binding FilterIndex}" MinWidth="140">
        <ComboBoxItem Content="{Binding L.LogsFilterAll}" />
        <ComboBoxItem Content="{Binding L.LogsFilterMovement}" />
        <ComboBoxItem Content="{Binding L.LogsFilterPauses}" />
        <ComboBoxItem Content="{Binding L.LogsFilterSystem}" />
      </ComboBox>
      <Button Content="{Binding L.LogsCopy}" Command="{Binding CopyCommand}" />
      <Button Content="{Binding L.LogsOpenFolder}" Command="{Binding OpenFolderCommand}" />
      <Button Content="{Binding L.LogsClear}" Command="{Binding ClearCommand}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Lines}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LogLineViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource GmFontMono}" Classes="muted" />
            <Border Width="76" CornerRadius="{DynamicResource GmControlRadius}" Padding="0,1"
                    Background="{Binding Kind, Converter={StaticResource KindBrush}}">
              <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                         Foreground="{Binding Kind, Converter={StaticResource KindInk}}" />
            </Border>
            <TextBlock Text="{Binding Message}" FontFamily="{DynamicResource GmFontMono}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
