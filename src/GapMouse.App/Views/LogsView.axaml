<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapMouse.App.ViewModels"
             xmlns:v="using:GapMouse.App.Views"
             x:Class="GapMouse.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <UserControl.Resources>
    <v:LogKindBrushConverter x:Key="KindBrush" />
    <v:LogKindInkConverter x:Key="KindInk" />
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.icon">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
  </UserControl.Styles>
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <ComboBox SelectedIndex="{Binding FilterIndex}" MinWidth="116">
        <ComboBoxItem Content="{Binding L.LogsFilterAll}" />
        <ComboBoxItem Content="{Binding L.LogsFilterMovement}" />
        <ComboBoxItem Content="{Binding L.LogsFilterPauses}" />
        <ComboBoxItem Content="{Binding L.LogsFilterSystem}" />
      </ComboBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Padding="10,5" Command="{Binding CopyCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xE8C8;" />
            <TextBlock Text="{Binding L.LogsCopy}" />
          </StackPanel>
        </Button>
        <Button Padding="10,5" Command="{Binding OpenFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xE838;" />
            <TextBlock Text="{Binding L.LogsOpenFolder}" />
          </StackPanel>
        </Button>
        <Button Padding="10,5" Command="{Binding ClearCommand}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="icon" Text="&#xE74D;" />
            <TextBlock Text="{Binding L.LogsClear}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
    <Border Classes="card" ClipToBounds="True">
      <Grid>
        <ListBox ItemsSource="{Binding Lines}" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 IsVisible="{Binding !!Lines.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLineViewModel">
              <Grid ColumnDefinitions="Auto,76,*" ColumnSpacing="10" Margin="4,2">
                <TextBlock Text="{Binding Time}" FontFamily="{DynamicResource GmFontMono}"
                           FontFeatures="tnum" Classes="muted" VerticalAlignment="Top" />
                <Border Grid.Column="1" Width="76" VerticalAlignment="Top"
                        CornerRadius="{DynamicResource GmControlRadius}" Padding="0,2"
                        Background="{Binding Kind, Converter={StaticResource KindBrush}}">
                  <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                             Foreground="{Binding Kind, Converter={StaticResource KindInk}}" />
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="muted" Text="{Binding L.LogsEmpty}" TextWrapping="Wrap"
                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="24" IsVisible="{Binding !Lines.Count}" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
