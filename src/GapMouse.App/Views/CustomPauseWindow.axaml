<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GapMouse.App.ViewModels"
        x:Class="GapMouse.App.Views.CustomPauseWindow"
        x:DataType="vm:CustomPauseViewModel"
        Title="{Binding L.CustomPauseTitle}"
        Icon="avares://GapMouse/Assets/Icons/gapmouse.ico"
        Width="340" SizeToContent="Height"
        Background="{DynamicResource GmGroundBrush}"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="12">
    <TextBlock Text="{Binding L.CustomPausePrompt}" TextWrapping="Wrap" />
    <TextBox Text="{Binding MinutesText, Mode=TwoWay}" />
    <TextBlock Text="{Binding Error}" Classes="error" MinHeight="18" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="accent" MinWidth="80" Content="{Binding L.Ok}" IsDefault="True" IsEnabled="{Binding CanConfirm}" Click="OnOk" />
      <Button MinWidth="80" Content="{Binding L.Cancel}" IsCancel="True" Click="OnCancel" />
    </StackPanel>
  </StackPanel>
</Window>
