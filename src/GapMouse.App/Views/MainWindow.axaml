<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GapMouse.App.ViewModels"
        xmlns:views="using:GapMouse.App.Views"
        x:Class="GapMouse.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GapMouse"
        Icon="avares://GapMouse/Assets/Icons/gapmouse.ico"
        Width="760" Height="600"
        MinWidth="640" MinHeight="520">
  <TabControl Classes="rail" TabStripPlacement="Left">
    <TabItem AutomationProperties.Name="{Binding L.TabHome}">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="railIcon" Text="&#xE80F;" />
          <TextBlock Text="{Binding L.TabHome}" VerticalAlignment="Center" />
        </StackPanel>
      </TabItem.Header>
      <views:HomeView DataContext="{Binding Home}" />
    </TabItem>
    <TabItem AutomationProperties.Name="{Binding L.TabLogs}">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="railIcon" Text="&#xE9F9;" />
          <TextBlock Text="{Binding L.TabLogs}" VerticalAlignment="Center" />
        </StackPanel>
      </TabItem.Header>
      <views:LogsView DataContext="{Binding Logs}" />
    </TabItem>
    <TabItem AutomationProperties.Name="{Binding L.TabSettings}">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="railIcon" Text="&#xE713;" />
          <TextBlock Text="{Binding L.TabSettings}" VerticalAlignment="Center" />
        </StackPanel>
      </TabItem.Header>
      <views:SettingsView DataContext="{Binding Settings}" />
    </TabItem>
    <TabItem AutomationProperties.Name="{Binding L.TabAbout}">
      <TabItem.Header>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Classes="railIcon" Text="&#xE946;" />
          <TextBlock Text="{Binding L.TabAbout}" VerticalAlignment="Center" />
        </StackPanel>
      </TabItem.Header>
      <views:AboutView DataContext="{Binding About}" />
    </TabItem>
  </TabControl>
</Window>
