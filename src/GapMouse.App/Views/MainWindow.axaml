<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GapMouse.App.ViewModels"
        xmlns:views="using:GapMouse.App.Views"
        x:Class="GapMouse.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="GapMouse"
        Icon="avares://GapMouse/Assets/Icons/gapmouse.ico"
        Width="760" Height="600"
        MinWidth="640" MinHeight="520">
  <TabControl>
    <TabItem Header="{Binding L.TabHome}">
      <views:HomeView DataContext="{Binding Home}" />
    </TabItem>
    <TabItem Header="{Binding L.TabLogs}">
      <views:LogsView DataContext="{Binding Logs}" />
    </TabItem>
    <TabItem Header="{Binding L.TabSettings}">
      <views:SettingsView DataContext="{Binding Settings}" />
    </TabItem>
    <TabItem Header="{Binding L.TabAbout}">
      <views:AboutView DataContext="{Binding About}" />
    </TabItem>
  </TabControl>
</Window>
