<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapMouse.App.ViewModels"
             xmlns:svc="using:GapMouse.App.Services"
             xmlns:v="using:GapMouse.App.Views"
             xmlns:shapes="using:Avalonia.Controls.Shapes"
             x:Class="GapMouse.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <UserControl.Resources>
    <v:ProgressToSweepConverter x:Key="Sweep" />
    <v:UpperCaseConverter x:Key="Upper" />
  </UserControl.Resources>
  <UserControl.Styles>
    <!-- Door-hanger face: the face sets its fill and ink (children inherit the ink; rings bind to it).
         The flip must live in each state-class style so it replays when the class becomes active. -->
    <Style Selector="ContentPresenter.face">
      <Setter Property="Width" Value="220" />
      <Setter Property="CornerRadius" Value="{DynamicResource GmCardRadius}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform">
        <ScaleTransform ScaleX="1" ScaleY="1" />
      </Setter>
    </Style>
    <Style Selector="ContentPresenter.face.waiting">
      <Setter Property="Background" Value="{DynamicResource GmStateWaitingBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GmStateWaitingInkBrush}" />
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ContentPresenter.face.waiting TextBlock.inkSecondary">
      <Setter Property="Foreground" Value="{DynamicResource GmStateWaitingInkSecondaryBrush}" />
    </Style>
    <Style Selector="ContentPresenter.face.moving">
      <Setter Property="Background" Value="{DynamicResource GmStateMovingBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GmStateMovingInkBrush}" />
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ContentPresenter.face.moving TextBlock.inkSecondary">
      <Setter Property="Foreground" Value="{DynamicResource GmStateMovingInkSecondaryBrush}" />
    </Style>
    <Style Selector="ContentPresenter.face.paused">
      <Setter Property="Background" Value="{DynamicResource GmStatePausedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GmStatePausedInkBrush}" />
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
          <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.3" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ContentPresenter.face.paused TextBlock.inkSecondary">
      <Setter Property="Foreground" Value="{DynamicResource GmStatePausedInkSecondaryBrush}" />
    </Style>

    <Style Selector="Ellipse.ring">
      <Setter Property="StrokeThickness" Value="6" />
    </Style>
    <Style Selector="Ellipse.ring.track">
      <Setter Property="Opacity" Value="0.25" />
    </Style>
    <Style Selector="shapes|Arc.ring">
      <Setter Property="StrokeThickness" Value="6" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StartAngle" Value="-90" />
    </Style>

    <Style Selector="Grid.stat">
      <Setter Property="Margin" Value="16,6" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="tnum" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.statLabel">
      <Setter Property="Foreground" Value="{DynamicResource GmTextMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource GmTextMutedBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid Margin="24" RowDefinitions="*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="220,16,*">
      <ContentPresenter Classes="face"
              Classes.waiting="{Binding IsWaiting}"
              Classes.moving="{Binding IsMoving}"
              Classes.paused="{Binding IsPaused}">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Width="56" Height="56" HorizontalAlignment="Left" AutomationProperties.AccessibilityView="Raw">
            <Ellipse Classes="ring track" Stroke="{Binding $parent[ContentPresenter].Foreground}" />
            <shapes:Arc Classes="ring"
                        Stroke="{Binding $parent[ContentPresenter].Foreground}"
                        SweepAngle="{Binding IdleProgress, Converter={StaticResource Sweep}}"
                        IsVisible="{Binding !IsPaused}" />
          </Grid>
          <StackPanel Grid.Row="2" Spacing="4">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
              <TextBlock
                         Text="{Binding StateText, Converter={StaticResource Upper}}"
                         FontFamily="{DynamicResource GmFontDisplay}"
                         FontSize="30" FontWeight="Bold" LetterSpacing="0.6" />
            </Viewbox>
            <TextBlock Classes="inkSecondary" Text="{Binding IdleText}" TextWrapping="Wrap" />
            <TextBlock Classes="inkSecondary" Text="{Binding PauseText}" TextWrapping="Wrap"
                       IsVisible="{Binding HasPauseText}" />
          </StackPanel>
        </Grid>
      </ContentPresenter>

      <StackPanel Grid.Column="2" Spacing="16">
        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="group" Text="{Binding L.HomeTodayTitle}" Margin="16,12,16,4" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeActiveTimeLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding TodayActiveTime}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeActivationsLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding TodayActivations}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel>
            <TextBlock Classes="group" Text="{Binding L.HomeRecentTitle}" Margin="16,12,16,4" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeStartedLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding StartedText}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeLastMovementLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding LastMovementText}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeLastReturnLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding LastReturnText}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeLastPauseLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding LastPauseText}" />
            </Grid>
            <Border Classes="divider" />
            <Grid Classes="stat" ColumnDefinitions="*,Auto">
              <TextBlock Classes="statLabel" Text="{Binding L.HomeLastResumeLabel}" />
              <TextBlock Classes="value" Grid.Column="1" Text="{Binding LastResumeText}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
      <DropDownButton Classes="accent" Content="{Binding L.HomePause}" IsVisible="{Binding !IsPaused}">
        <DropDownButton.Flyout>
          <MenuFlyout>
            <MenuItem Header="{Binding L.PauseTenMinutes}" Command="{Binding PauseCommand}"
                      CommandParameter="{x:Static svc:PauseOption.TenMinutes}" />
            <MenuItem Header="{Binding L.PauseThirtyMinutes}" Command="{Binding PauseCommand}"
                      CommandParameter="{x:Static svc:PauseOption.ThirtyMinutes}" />
            <MenuItem Header="{Binding L.PauseOneHour}" Command="{Binding PauseCommand}"
                      CommandParameter="{x:Static svc:PauseOption.OneHour}" />
            <MenuItem Header="{Binding L.PauseCustom}" Command="{Binding PauseCommand}"
                      CommandParameter="{x:Static svc:PauseOption.Custom}" />
            <MenuItem Header="{Binding L.PauseNever}" Command="{Binding PauseCommand}"
                      CommandParameter="{x:Static svc:PauseOption.Never}" />
          </MenuFlyout>
        </DropDownButton.Flyout>
      </DropDownButton>
      <Button Classes="accent" Content="{Binding L.HomeResume}" Command="{Binding ResumeCommand}"
              IsVisible="{Binding IsPaused}" />
      <Button Grid.Column="2" Classes="quiet" Content="{Binding L.HomeExit}" Command="{Binding ExitCommand}" />
    </Grid>
  </Grid>
</UserControl>
