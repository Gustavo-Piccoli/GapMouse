<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GapMouse.App.ViewModels"
             x:Class="GapMouse.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">
      <TextBlock Text="{Binding L.AppName}" FontSize="28" FontWeight="SemiBold" />
      <TextBlock>
        <Run Text="{Binding L.AboutVersionLabel}" />
        <Run Text="{Binding VersionText}" />
      </TextBlock>
      <TextBlock>
        <Run Text="{Binding L.AboutLicenseLabel}" />
        <Run Text="{Binding LicenseText}" />
      </TextBlock>

      <StackPanel Spacing="4">
        <TextBlock Text="{Binding L.AboutRepositoryLabel}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding RepositoryUrl}" TextWrapping="Wrap" />
        <Button Content="{Binding L.AboutOpenRepository}" Command="{Binding OpenRepositoryCommand}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{Binding L.AboutSettingsFileLabel}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SettingsFilePath}" TextWrapping="Wrap" />
        <Button Content="{Binding L.AboutOpenSettingsFolder}" Command="{Binding OpenSettingsFolderCommand}" />
      </StackPanel>

      <StackPanel Spacing="4">
        <TextBlock Text="{Binding L.AboutLogsFolderLabel}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding LogsDirectory}" TextWrapping="Wrap" />
        <Button Content="{Binding L.AboutOpenLogsFolder}" Command="{Binding OpenLogsFolderCommand}" />
      </StackPanel>

      <StackPanel Spacing="8">
        <Button Content="{Binding L.AboutCheckUpdates}" Command="{Binding CheckUpdatesCommand}" />
        <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
        <Button Content="{Binding L.AboutOpenRelease}" Command="{Binding OpenReleaseCommand}"
                IsVisible="{Binding AvailableReleaseUrl, Converter={x:Static ObjectConverters.IsNotNull}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
